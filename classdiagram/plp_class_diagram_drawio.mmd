classDiagram
direction LR

class AppConfig {
  +String baseUrl
  +String loginEndpoint
  +String registerEndpoint
  +String logbooksEndpoint
  +String laporanAnonimEndpoint
}

class UserModel {
  +int id
  +String name
  +String email
  +String role
}

class Mahasiswa
class DosenPembimbing
class GuruPamong
class DosenKoordinator
class GuestReporter

UserModel <|-- Mahasiswa
UserModel <|-- DosenPembimbing
UserModel <|-- GuruPamong
UserModel <|-- DosenKoordinator

class PaktaIntegritas {
  +bool disetujui
}
Mahasiswa "1" --> "1" PaktaIntegritas : konfirmasi

class LogbookModel {
  +int id
  +int userId
  +String tanggal
  +String keterangan
  +String mulai
  +String selesai
  +String dokumentasi
  +String status
  +String yourApprovalStatus
}

Mahasiswa "1" --> "0..*" LogbookModel : membuat/mengedit/menghapus
DosenPembimbing "1" --> "0..*" LogbookModel : validasi
GuruPamong "1" --> "0..*" LogbookModel : validasi
DosenKoordinator "1" --> "0..*" LogbookModel : lihat semua

class LaporanAnonimModel {
  +int id
  +String studentName
  +String incidentDescription
  +String incidentDate
  +String source
  +String createdAt
  +bool isRead
}

Mahasiswa "1" --> "0..*" LaporanAnonimModel : kirim laporan
GuestReporter "1" --> "0..*" LaporanAnonimModel : kirim laporan
DosenKoordinator "1" --> "0..*" LaporanAnonimModel : lihat/investigasi/tandai dibaca

class SimpleLoginResponse {
  +int id
  +String email
  +String token
  +String tokenType
  +String status
  +bool verified
}

class AuthResponseModel {
  +String status
  +String message
}

class AuthData {
  +UserModel user
  +String token
}

AuthResponseModel *-- AuthData
AuthData *-- UserModel

class AuthService {
  +register(name,email,password,passwordConfirmation)
  +login(email,password)
  +requestPasswordReset(email)
}

class LogbookService {
  +getLogbooks()
  +createLogbookRaw(...)
  +updateLogbook(id,...)
  +deleteLogbook(id)
  +getAllLogbooks()
  +getLogbooksForValidation()
  +updateValidationStatus(id,status)
}

class LaporanAnonimService {
  +submitLaporanAnonim(studentName,incidentDescription,incidentDate)
  +getLaporanAnonimForCoordinator()
  +markLaporanAsRead(reportId)
}

class AkunService {
  +getAllUsers()
  +getUserNameById(userId)
  +getAllUsersByRole(role)
}

LogbookService ..> AppConfig
LaporanAnonimService ..> AppConfig
AuthService ..> AppConfig
AkunService ..> AppConfig

LogbookService ..> LogbookModel
LaporanAnonimService ..> LaporanAnonimModel
AkunService ..> UserModel

class LoginController {
  +login()
  +goToRegister()
  +forgotPassword()
}

class CreateprofileController {
  +createAccount()
  +goToLogin()
}

class IsilogbookController {
  +fetchLogbookData()
  +goToTambahLogbook()
  +goToEditLogbook(logbook)
  +deleteLogbook(id)
}

class FormlogbookController {
  +submitLogbook()
  +convertTanggalToIso(input)
  +formatJam(input)
}

class ValidasilogbookController {
  +fetchLogbooksValidasi()
  +validateLogbook(id,status)
}

class LihatlogbookallController {
  +fetchAllData()
  +getUserName(userId)
}

class LaporananonimController {
  +submitAnonymousReport()
}

class LihatpelaporanController {
  +fetchLaporan()
  +tandaiDibaca(reportId)
}

LoginController ..> AuthService
LoginController ..> SimpleLoginResponse
CreateprofileController ..> AuthService
CreateprofileController ..> AuthResponseModel

IsilogbookController ..> LogbookService
FormlogbookController ..> LogbookService
ValidasilogbookController ..> LogbookService
LihatlogbookallController ..> LogbookService
LihatlogbookallController ..> AkunService

LaporananonimController ..> LaporanAnonimService
LihatpelaporanController ..> LaporanAnonimService

class LogbookWorkflow {
  +konfirmasiPaktaIntegritas()
  +buatLogbook()
  +kirimLogbook()
  +validasiLogbook()
  +perbaikiLogbook()
}

class PelaporanWorkflow {
  +bukaHalamanLaporan()
  +kirimLaporan()
  +terimaLaporan()
  +investigasi()
}

Mahasiswa ..> LogbookWorkflow
DosenPembimbing ..> LogbookWorkflow
GuruPamong ..> LogbookWorkflow
DosenKoordinator ..> LogbookWorkflow

Mahasiswa ..> PelaporanWorkflow
GuestReporter ..> PelaporanWorkflow
DosenKoordinator ..> PelaporanWorkflow

LogbookWorkflow ..> LogbookModel
LogbookWorkflow ..> PaktaIntegritas
LogbookWorkflow ..> LogbookService
PelaporanWorkflow ..> LaporanAnonimModel
PelaporanWorkflow ..> LaporanAnonimService
